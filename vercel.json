{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/services", "destination": "/index.html" },
    { "source": "/lawn-mowing-live-oak-fl", "destination": "/index.html" },
    { "source": "/acreage-mowing-live-oak-fl", "destination": "/index.html" },
    { "source": "/handyman-services-live-oak-fl", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/service-area", "destination": "/index.html" },
    { "source": "/blog", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
